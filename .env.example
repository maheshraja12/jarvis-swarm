# Copy this file to .env and adjust for your machine. Never commit .env.
JARVIS_BRAIN_MODE=auto
JARVIS_TRIGGER_MODE=hybrid
JARVIS_ENABLE_WEB_SERVER=true
JARVIS_ENABLE_VISION=false
JARVIS_ENABLE_SWARM=true
JARVIS_ENABLE_UNSAFE_CUSTOM_TOOLS=0
JARVIS_API_TOKEN=
JARVIS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
GROQ_API_KEY=
